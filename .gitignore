# Ignore Drupal core & scaffolded files
html/*
!html/modules/
html/modules/*
!html/modules/custom/
!html/sites/
html/sites/*
!html/sites/default/
html/sites/default/*
!html/sites/default/settings.local.php
!html/themes/
html/themes/*
!html/themes/custom/

# Ignore Composer vendor folders
/vendor/

# Ignore NPM folders
node_modules

# Ignore recipes folder
/recipes

# Ignore Development Files
.idea
*.backup
*.diff
*.DS_Store
*.err
*.log
*.orig
*.prettierignore
*.rej
*.sass-cache
*.swo
*.swp
*.vi
compass_app_log.txt
ddev-cron-log.txt
*.css.map

# SASS
.sass-cache
*.sass-cache*
**/sass/*.css

# Ignore Exports
*.gz
*.sql
*.zip

# Ignore Temporary and Private Files
private
private-files
tmp

# Ignore DDEV
.ddev/*
!.ddev/config.yaml

