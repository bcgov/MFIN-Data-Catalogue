{
  
    This is not a full composer.json file, but encapsulates elements that need to have included (merged) in to it.
    
    YOU NEED TO RUN THE FOLLOWING COMMANDS BEFORE MERGING THIS:
    ddev composer require drush/drush cweagans/composer-patches
    ddev composer require drupal/coder --dev
    
    Please delete these comment lines!! (They are not valid JSON.)

  "require": {

    IMPORTANT: When updating Drupal core to a new version, be sure 
    to also switch to the corresponding branch in WXT-Drupal-Scaffold, 
    which is merged into this branch. You'll need to 'git subtree merge'
    it in.
    
    (In the case of Drupal 10.5, there was no matching version in docker-scaffold,
     so we're using 10.6 from there.)
    "drupal/core-composer-scaffold": "~10.5.4",
    "drupal/core-recommended": "~10.5.4"

  },
  "extra": {
    "composer-exit-on-patch-failure": true,
    "enable-patching": true,
    "patchLevel": {
      "drupal/core": "-p2"
    },
    "patches": {
      "drupal/core": {
        "571548 - Identifiers longer than 63 characters are truncated, causing Views to break on Postgres": "https://www.drupal.org/files/issues/2025-01-16/drupal-postgres_identifiers_10_4-571548-207.patch"
      }
    }
  }
}
