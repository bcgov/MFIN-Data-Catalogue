{
    "name": "bcgov-c/mfin-data-catalogue",
    "description": "BC MFIN Data Catalogue",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/bcgov-c/MFIN-Data-Catalogue",
    "repositories": [
        {
          "type": "path",
          "url": "html/MONITOR_this_dir/field_count_formatter",
          "options": {
            "symlink": true
          }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "vcs",
            "url": "https://github.com/danhgov/GDX-Analytics-Drupal-Snowplow.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/openplus/opbb"
        },
        {
            "type": "package",
            "package": {
                "name": "billboardjs/billboard",
                "version": "3.10.3",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "billboard"
                },
                "dist": {
                    "url": "https://registry.npmjs.org/billboard.js/-/billboard.js-3.10.3.tgz",
                    "type": "tar"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "d3/d3",
                "version": "7.8.5",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "d3"
                },
                "dist": {
                    "url": "https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js",
                    "type": "file"
                },
                "require": {
                    "composer/installers": "^1.0 || ^2.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "jquery/fancytree",
                "version": "2.37.0",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "jquery.fancytree"
                },
                "dist": {
                    "url": "https://github.com/mar10/fancytree/archive/refs/tags/v2.37.0.zip",
                    "type": "zip"
                },
                "license": "MIT"
            }
        },
        {
            "type": "package",
            "package": {
                "name": "tabby/tabby",
                "version": "12.0.3",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "tabby"
                },
                "dist": {
                    "url": "https://github.com/cferdinandi/tabby/archive/refs/tags/v12.0.3.zip",
                    "type": "zip"
                },
                "license": "MIT"
            }
        }
    ],
    "require": {
        "bcgov/gdx_analytics_drupal_snowplow": "dev-main",
        "billboardjs/billboard": "^3.10",
        "bower-asset/codemirror": "^6.65",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1",
        "d3/d3": "^7.8",
        "drupal/action": "^0.2",
        "drupal/admin_toolbar": "^3.0",
        "drupal/auto_username": "^2.0",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/book": "^2.0",
        "drupal/bootstrap5": "^4",
        "drupal/cancel_button": "^1.4",
        "drupal/charts": "^5.0",
        "drupal/chosen": "^5.0",
        "drupal/ckeditor5_fullscreen": "^1.0@beta",
        "drupal/ckeditor_codemirror": "^3.0@beta",
        "drupal/clipboardjs": "^2.1@RC",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_filter": "^2.4",
        "drupal/config_ignore": "^3.1",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11.2",
        "drupal/core-recommended": "^11.2",
        "drupal/date_popup": "^2.0",
        "drupal/devel": "^5.0",
        "drupal/devel_php": "^1.5",
        "drupal/diff": "^1.9",
        "drupal/entity_clone": "^2.1@beta",
        "drupal/entity_embed": "^1.5",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/environment_indicator": "^4.0",
        "drupal/facets": "^2.0",
        "drupal/field_count_formatter": "@dev",
        "drupal/field_group": "^4.0",
        "drupal/field_label": "^1.5",
        "drupal/field_permissions": "^1.2",
        "drupal/flag": "^5.0",
        "drupal/form_mode_control": "^2.2",
        "drupal/formatter_suite": "^2.0",
        "drupal/gin": "~5.0.12",
        "drupal/gin_toolbar": "~3.0.3",
        "drupal/hal": "^2.0",
        "drupal/hierarchical_term_formatter": "^1.3",
        "drupal/insert_view_adv": "^2.0@alpha",
        "drupal/linkit": "^7.0",
        "drupal/menu_link_attributes": "^1.6",
        "drupal/message_gcnotify": "^1.0.1",
        "drupal/metatag": "^2.0",
        "drupal/openid_connect": "^3.0@alpha",
        "drupal/page_manager": "^4.0",
        "drupal/panels": "^4.7",
        "drupal/paragraphs": "^1.15",
        "drupal/paragraphs_features": "^2.0@beta",
        "drupal/pathauto": "^1.11",
        "drupal/r4032login": "^2.2",
        "drupal/rabbit_hole": "^2.0@alpha",
        "drupal/realname": "^2.0",
        "drupal/redirect": "^1.11",
        "drupal/registration_role": "^2.0",
        "drupal/robotstxt": "^1.5",
        "drupal/role_delegation": "^1.5",
        "drupal/search_api": "^1.29",
        "drupal/search_api_saved_searches": "^1.0",
        "drupal/search_api_solr": "^4.2",
        "drupal/shs": "^2.0@RC",
        "drupal/smart_trim": "^2.1.1",
        "drupal/smtp": "^1.2",
        "drupal/statistics": "^1.0",
        "drupal/structure_sync": "^2.0",
        "drupal/svg_image": "^3.0",
        "drupal/tac_lite": "^2.0",
        "drupal/taxonomy_import": "^2.0",
        "drupal/taxonomy_manager": "^2.0",
        "drupal/taxonomy_max_depth": "^2.0",
        "drupal/telephone_formatter": "^1.3",
        "drupal/telephone_validation": "^2.5",
        "drupal/toc_filter": "^2.1",
        "drupal/token": "^1.11",
        "drupal/token_filter": "^2.0",
        "drupal/twig_tweak": "^3.2",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/vbo_export": "^4.1",
        "drupal/views_argument_token": "^2.0",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "4.3.3",
        "drupal/views_data_export": "^1.4",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/webform": "^6.3",
        "drupal/webform_content_creator": "^4.0",
        "drush/drush": "^13.0",
        "jquery/fancytree": "^2",
        "npm-asset/cdubz--ckeditor5-source-editing-codemirror": "^35.1",
        "npm-asset/clipboard": "^2.0.11",
        "npm-asset/noli42--chosen": "^3.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "phpoffice/phpspreadsheet": "^2.0",
        "tabby/tabby": "^12.0",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2",
        "weitzman/drupal-test-traits": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "audit": {
            "ignore": [
                "SA-CORE-2026-001",
                "SA-CORE-2026-002"
            ]
        },
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "clean-billboardjs": "./scripts/clean-billboardjs.sh",
        "pre-install-cmd": [
            "BCGovC\\MfinDataCatalogue\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "BCGovC\\MfinDataCatalogue\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "@clean-billboardjs",
            "BCGovC\\MfinDataCatalogue\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "@clean-billboardjs",
            "BCGovC\\MfinDataCatalogue\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/robots.txt": false
            },
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/chosen": [
                "npm-asset/noli42--chosen"
            ],
            "html/libraries/ckeditor5-source-editing-codemirror": [
                "npm-asset/cdubz--ckeditor5-source-editing-codemirror"
            ],
            "html/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "html/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "html/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "html/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/charts": {
                "3442641 - Chart segments are all the same color in Views pie/donut charts": "https://www.drupal.org/files/issues/2024-04-22/charts-pie_donut_colors-3442641-4.patch",
                "3456882 - HTML encodings (e.g. '&amp;') showing up in legend": "https://www.drupal.org/files/issues/2024-06-26/3456882-html-encoding-fix.patch"
            },
            "drupal/conditional_fields": {
                "2550167 - Allow creating dependency on taxonomy parent term": "https://www.drupal.org/files/issues/2025-01-17/conditional_fields-taxonomy_parent_term-2550167.patch"
            },
            "drupal/core": {
                " 571548 - Identifiers longer than 63 characters are truncated, causing Views to break on Postgres": "composer.patches/571548.core.mr6379-as-at-2026-04-22.patch.txt",
		            "2280479 - Add setting to EntityReferenceSelection plugins to prevent references to referencing entity": "https://www.drupal.org/files/issues/2024-12-11/drupal-self_reference_d11-2280479-106.patch",
                "2821962 - Views exposed filters don't combine with contextual filters when using exposed form in block": "https://www.drupal.org/files/issues/2024-03-19/drupal-exposed-contextual-filters-2821962-65.patch",
                "3079534 - Views JOIN condition fails in PostgreSQL when comparing entity identifiers of different datatypes": "https://www.drupal.org/files/issues/2024-01-17/drupal-views_postgres_join_no_tests-3079534-36.patch",
                "2840283 - Problem with action path for embedded forms": "https://www.drupal.org/files/issues/2020-03-19/linked-display-2840283-40_1.patch",
                "3392572 - strnatcasecmp(): Passing null to string is deprecated": "https://www.drupal.org/files/issues/2023-10-25/drupal-strnatcasecmp_string_only-3392572-10.patch"
            },
            "drupal/ctools": {
                "2759445 - Manually pass an argument to a views block through interface": "https://www.drupal.org/files/issues/2023-01-18/2759445-100.patch"
            },
            "drupal/diff": {
                "2954352 - Local tasks for node not visible on diff.revisions_diff route": "https://www.drupal.org/files/issues/2024-05-16/diff-add_local_tasks-2954352-17.patch"
            },
            "drupal/page_manager": {
                "2756613 - Avoid harcoded prefex and suffix in block region": "https://www.drupal.org/files/issues/page_manager-avoid_prefix_suffix-2756613-8.patch"
            },
            "drupal/panels": {
                "2820617 - Avoid hard-coded prefix and suffix in block region": "composer.patches/2820617.panels.mr12-as-at-2024-01-10.patch.txt",
                "2910704 - IPE toggle preview not working in IE": "https://www.drupal.org/files/issues/panels-ipe-card-flip-ie-error-2910704.diff"
            },
            "drupal/role_delegation": {
                "3475414 - Allow users with administer users to see Roles tab via a setting": "composer.patches/3475414.role_delegation.mr19-as-at-2026-02-12.patch.txt",
                "3284859 - Roles being stripped from users when saved if user has no access to roles field": "composer.patches/3284859.role_delegation.mr6-as-at-2026-04-30.patch.txt"
            },
            "drupal/shs": {
                "3284824 - Schema definition for entity_reference_shs field formatter missing": "https://www.drupal.org/files/issues/2022-06-09/shs-schema_formatter_missing-3284824-2.patch"
            },
            "drupal/tac_lite": {
                "3420249 - Create token for use in Views": "https://www.drupal.org/files/issues/2024-02-08/tac_lite-token-3420249-2.patch",
                "3203718 - add the ability to select all terms from a vocabulary": "https://www.drupal.org/files/issues/2021-03-15/tac_lite-add_all_option-3203718-2.patch",
                "3359802 - Add schema for tac_lite.settings": "https://www.drupal.org/files/issues/2023-05-11/tac_lite-schema-3359802-2.patch",
                "3403235 - Allow specifying which field to use for access control": "https://www.drupal.org/files/issues/2023-11-21/tac_lite-choose_fields-3403235-2.patch"
            },
            "drupal/taxonomy_delete": {
                "3434896 - Automated Drupal 11 compatibility fixes": "https://www.drupal.org/files/issues/2024-03-25/taxonomy_delete.8.x-1.5.rector.patch"
            },
            "drupal/vbo_export": {
                "3257067 - Ensure PrivateTempStore key is not too long": "https://www.drupal.org/files/issues/2023-06-29/vbo_export-cid_too_long-3257067-9.patch"
            }
        }
    },
    "require-dev": {
        "kint-php/kint": "^5.0"
    }
}
