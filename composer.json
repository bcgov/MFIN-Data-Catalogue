{
    "_newbb_comment": "This is not a full composer.json file, but encapsulates elements that need to have included (merged) in to it.",
    "_newbb_comment_2": "Delete these comments as part of the merge.",

    "require": {
        "cweagans/composer-patches": "^1.7"
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "571548 - Identifiers longer than 63 characters are truncated, causing Views to break on Postgres": "https://www.drupal.org/files/issues/2025-01-16/drupal-postgres_identifiers_10_4-571548-207.patch"
            }
        }
    }
}
