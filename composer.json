{
    "name": "bcgov-c/fintranet",
    "description": "Ministry of Finance Intranet",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/bcgov-c/fintranet",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bcgov/bcbb"
        },
        {
            "type": "vcs",
            "url": "https://github.com/chrislaick/gdx_analytics_drupal_snowplow"
        }
    ],
    "require": {
        "bcgov/bcbb": "1.0.x@dev",
        "bcgov/gdx_analytics_drupal_snowplow": "dev-main",
        "bower-asset/jquery-simple-color": "^1.2",
        "bower-asset/photoswipe": "^4.1",
        "bower-asset/slick-carousel": "^1.8",
        "bower-asset/spectrum": "^1.8",
        "composer/installers": "^2.2",
        "drupal-ckeditor-libraries-group/templates": "^4.19",
        "drupal/ajax_loader": "^2.0",
        "drupal/anchor_link": "^1.7",
        "drupal/blazy": "^2.11",
        "drupal/block_content_permissions": "^1.10",
        "drupal/block_permissions": "^1.2",
        "drupal/bootstrap_site_alert": "^1.9",
        "drupal/bulk_edit_terms": "^1.3",
        "drupal/ckeditor_accordion": "^2.1",
        "drupal/ckeditor_templates": "^1.2",
        "drupal/ckeditor_templates_ui": "^1.4",
        "drupal/ckeditor_youtube": "^1.4",
        "drupal/classy": "^1.0",
        "drupal/color_field": "^3.0",
        "drupal/config_default_image": "^2.0@beta",
        "drupal/core-composer-scaffold": "~10.2.7",
        "drupal/core-recommended": "~10.2.7",
        "drupal/crop": "^2.2",
        "drupal/cshs": "^4.0",
        "drupal/default_content": "^2.0@alpha",
        "drupal/disable_field": "^3.0",
        "drupal/editor_advanced_link": "^2.0",
        "drupal/entity_pager": "^1.0@RC",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/entityqueue": "^1.2",
        "drupal/facets": "^2.0",
        "drupal/field_formatter": "^3.0",
        "drupal/field_formatter_class": "^1.5",
        "drupal/field_permissions": "^1.1",
        "drupal/file_download_link": "^2.0",
        "drupal/filefield_paths": "^1.0@beta",
        "drupal/focal_point": "^2.0",
        "drupal/fontawesome": "^2.23",
        "drupal/fullcalendar_view": "^5.1",
        "drupal/gin_moderation_sidebar": "^1.0",
        "drupal/jquery_once": "^1.0",
        "drupal/key_value_field": "^1.2",
        "drupal/layout_builder_component_attributes": "^2.0",
        "drupal/layout_library": "^1.0@beta",
        "drupal/mailsystem": "^4.3",
        "drupal/media_entity_download": "^2.2",
        "drupal/media_file_delete": "^1.1",
        "drupal/media_library_extras": "1.x-dev@dev",
        "drupal/menu_link_attributes": "^1.2",
        "drupal/moderation_sidebar": "^1.5",
        "drupal/node_revision_delete": "^1.0@RC",
        "drupal/openid_connect": "3.x-dev@dev",
        "drupal/photoswipe": "^4.0",
        "drupal/phpmailer_smtp": "^2.0",
        "drupal/poll": "^1.5",
        "drupal/publication_date": "^2.0@beta",
        "drupal/quick_node_clone": "^1.15",
        "drupal/r4032login": "^2.2",
        "drupal/redirect": "^1.7",
        "drupal/scheduler": "^1.4",
        "drupal/shariff": "^2.0",
        "drupal/similarterms": "^1.5",
        "drupal/simple_gmap": "^3.0",
        "drupal/slick": "^2.6",
        "drupal/slick_views": "^2.6",
        "drupal/smart_date": "^4.0",
        "drupal/smart_trim": "^2.0",
        "drupal/svg_image_field": "^2.2@beta",
        "drupal/table_bs_filter": "^2.0",
        "drupal/unique_field_ajax": "^2.1",
        "drupal/views_exposed_filter_blocks": "^1.1",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/we_megamenu": "1.x-dev@dev",
        "drupal/webform": "^6.1",
        "drupal/workflow_buttons": "^1.0@beta",
        "npm-asset/blazy": "^1.8",
        "npm-asset/shariff": "^3.2",
        "oomphinc/composer-installers-extender": "^2.0",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2",
        "weitzman/drupal-test-traits": "^2.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "wikimedia/composer-merge-plugin": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "autoload": {
        "files": ["load.environment.php"]
    },
    "scripts": {
        "pre-install-cmd": [
            "BCGovC\\Fintranet\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "BCGovC\\Fintranet\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "BCGovC\\Fintranet\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "BCGovC\\Fintranet\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[web-root]/robots.txt": false
            },
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "html/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "html/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "html/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "composer-exit-on-patch-failure": true,
        "merge-plugin": {
            "include": [
            ]
        },
        "patches": {
            "drupal/ckeditor_templates_ui": {
                "3408011 - Use of static in callables is deprecated": "https://git.drupalcode.org/project/ckeditor_templates_ui/-/merge_requests/2.diff"
            },
            "drupal/ckeditor_youtube": {
                "3317281 - Replace CKEditor Youtube button with existing 32 x 32 icon": "https://git.drupalcode.org/project/ckeditor_youtube/-/merge_requests/2.patch"
            },
            "drupal/core": {
                "962664 - Taxonomy Index for unpublished entities": "https://www.drupal.org/files/issues/2023-12-19/962664-206.patch",
                "3185321 - Only set a default name for the media item if mapped in the media source": "https://www.drupal.org/files/issues/2021-12-24/3185321-30.patch",
                "3388913 - Checkbox for Media library modal missing after search": "https://www.drupal.org/files/issues/2024-01-30/3388913-48-d10.1.patch"
            },
            "drupal/layout_library": {
                "3133484 - Form blocks rendered inside layout builder library break save": "https://www.drupal.org/files/issues/2020-05-04/layout-library-save-issue-3133484-4.patch"
            },
            "drupal/openid_connect": {
                "3265805 - Make login not fail when user is already logged in": "https://git.drupalcode.org/project/openid_connect/-/merge_requests/41.diff",
                "3011413 - Autologin when one client enabled": "https://www.drupal.org/files/issues/2023-10-16/openid_connect-autologin-3011413-99.patch"
            },
            "drupal/rabbit_hole": {
                "3375025 - TypeError: array_map(): Argument #2": "https://www.drupal.org/files/issues/2023-07-17/3375025-2.patch"
            },
            "drupal/we_megamenu": {
                "3447665 - Error: Attempt to modify property menu_config on null in we_megamenu_entity_insert": "https://www.drupal.org/files/issues/2024-05-16/modify_property_menu_config_null_3447665_1.patch"
            }
        }
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "mglaman/drupal-check": "^1.4",
        "drupal/core-dev": "^10.1",
        "kint-php/kint": "^5.0"
    }
}
