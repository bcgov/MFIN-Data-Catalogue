##########
#
# This section used by Docker.
#

# Not sure exactly what BASE_IMAGE is... appears to get used to set 'NAME',
#  which then appears to be used with docker commands. I think it is the
#  docker registry name/ repository name, as mentioned in https://stackoverflow.com/questions/34004076/difference-between-docker-registry-and-repository
# I'm thinking that github actions provides its own docker repository for use during the execution of an action,
# and that it needs to share the name of the git repo itself to work properly.
BASE_IMAGE=bcgov-c/mfin-data-catalogue

# It seems like these two need to match the value of
#   the 'BUILD2_CONTAINER_IMAGE_NAME' github-actions variable.
#   And I think they also need to match the part after the slash of 'BASE_IMAGE', above.
DOCKER_NAME=mfin-data-catalogue
DOCKER_IMAGE=mfin-data-catalogue


#
# The following items are used in the /docker directory during Drupal *site setup*.
#

# The database name
DB_NAME=mfin

# The database type mysql or pgsql
# DB_TYPE=mysql
# DB_PORT=3306

# The installation profile
PROFILE_NAME=minimal

# The relative location of the Behat tests
BEHAT_PATH=modules/contrib/bcbb/tests

#
##########
